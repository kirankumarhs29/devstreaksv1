-- Challenge Path.sq
CREATE TABLE ChallengePath (
  id TEXT PRIMARY KEY,
  track TEXT NOT NULL
);

-- Task Table (Updated to support all ChallengeTask fields)
CREATE TABLE ChallengeTask (
  id TEXT PRIMARY KEY,
  pathId TEXT NOT NULL,
  day INTEGER NOT NULL,
  title TEXT NOT NULL,
  type TEXT NOT NULL,
  content TEXT NOT NULL,
  xp INTEGER NOT NULL,
  checklist TEXT,
  whyItMatters TEXT,
  bonus TEXT,
  tip TEXT,
  aiBreakdown TEXT,
  videoUrl TEXT,
  codeExample TEXT,
  FOREIGN KEY (pathId) REFERENCES ChallengePath(id)
);


CREATE TABLE ChallengeActivity (
    id TEXT PRIMARY KEY,
    taskId TEXT NOT NULL,
    type TEXT NOT NULL,
    prompt TEXT NOT NULL,
    options TEXT,
    correctAnswer TEXT,
    language TEXT,
    starterCode TEXT,
    explanation TEXT,
    videoUrl TEXT
);

CREATE TABLE userEngagement (
    id TEXT PRIMARY KEY,
    taskId TEXT,
    userId TEXT,
    startTime INTEGER,
    endTime INTEGER,
    durationMillis INTEGER
);


CREATE TABLE UserStats (
    id TEXT PRIMARY KEY,
    xp INTEGER,
    streak INTEGER,
    lastCompletedDate TEXT
);

CREATE TABLE ChecklistProgress (
    id TEXT PRIMARY KEY, -- UUID
    taskId TEXT NOT NULL,
    item TEXT NOT NULL,
    isChecked INTEGER NOT NULL, -- 0 = false, 1 = true
    FOREIGN KEY (taskId) REFERENCES ChallengeTask(id)
);
CREATE TABLE CompletedChallenge (
    pathId TEXT NOT NULL,
    completedDate TEXT NOT NULL
);

CREATE TABLE TaskReflection (
    id TEXT PRIMARY KEY, -- Add this line (UUID)
    taskId TEXT NOT NULL,
    reflection TEXT NOT NULL,
    timestamp TEXT NOT NULL
);

-- NEW: Performance Metrics table for Dynamic Difficulty Adjustment
CREATE TABLE PerformanceMetrics (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    taskId TEXT NOT NULL,
    startTime INTEGER NOT NULL,
    endTime INTEGER NOT NULL,
    durationMillis INTEGER NOT NULL,
    attempts INTEGER NOT NULL,
    hintsUsed INTEGER NOT NULL,
    completed INTEGER NOT NULL, -- 0 = false, 1 = true
    errorCount INTEGER NOT NULL,
    difficultyLevel INTEGER NOT NULL, -- 1-5 corresponding to DifficultyLevel enum
    timestamp INTEGER NOT NULL
);

-- NEW: User Performance Summary cache table
CREATE TABLE UserPerformanceSummary (
    userId TEXT PRIMARY KEY,
    averageCompletionTime INTEGER NOT NULL,
    successRate REAL NOT NULL,
    averageAttempts REAL NOT NULL,
    averageHintsUsed REAL NOT NULL,
    averageErrorCount REAL NOT NULL,
    currentDifficultyLevel INTEGER NOT NULL,
    recentTaskCount INTEGER NOT NULL,
    lastUpdated INTEGER NOT NULL
);

-- NEW: Weak Areas Detection table
CREATE TABLE WeakArea (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    skillArea TEXT NOT NULL,
    category TEXT NOT NULL,
    severityScore REAL NOT NULL,
    frequencyCount INTEGER NOT NULL,
    lastEncountered INTEGER NOT NULL,
    averageAttempts REAL NOT NULL,
    averageTimeSpent INTEGER NOT NULL,
    commonErrors TEXT NOT NULL, -- JSON array as text
    improvementTrend TEXT NOT NULL,
    confidenceLevel REAL NOT NULL,
    timestamp INTEGER NOT NULL
);

-- NEW: Personalized Coaching Context cache
CREATE TABLE CoachingContext (
    userId TEXT PRIMARY KEY,
    motivationalState TEXT NOT NULL,
    preferredCoachingStyle TEXT NOT NULL,
    contextSummary TEXT NOT NULL,
    lastUpdated INTEGER NOT NULL
);


