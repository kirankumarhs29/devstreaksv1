-- NEW: Performance Metrics Queries for Dynamic Difficulty Adjustment

-- Insert performance metrics
insertPerformanceMetrics:
INSERT INTO PerformanceMetrics(
    id, userId, taskId, startTime, endTime, durationMillis,
    attempts, hintsUsed, completed, errorCount, difficultyLevel, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get recent performance metrics for a user (for difficulty calculation)
selectRecentPerformanceMetrics:
SELECT * FROM PerformanceMetrics
WHERE userId = ?
ORDER BY timestamp DESC
LIMIT ?;

-- Get performance metrics for a specific task
selectPerformanceByTask:
SELECT * FROM PerformanceMetrics
WHERE taskId = ? AND userId = ?;

-- Update or insert user performance summary
insertOrReplaceUserPerformanceSummary:
INSERT OR REPLACE INTO UserPerformanceSummary(
    userId, averageCompletionTime, successRate, averageAttempts,
    averageHintsUsed, averageErrorCount, currentDifficultyLevel,
    recentTaskCount, lastUpdated
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get user performance summary
selectUserPerformanceSummary:
SELECT * FROM UserPerformanceSummary WHERE userId = ?;

-- Get average performance by difficulty level (for baseline calculations)
selectAveragePerformanceByDifficulty:
SELECT
    difficultyLevel,
    AVG(durationMillis) AS avgDuration,
    AVG(CAST(completed AS REAL)) AS success_rate,
    AVG(attempts) AS avgAttempts,
    AVG(hintsUsed) AS avgHints,
    AVG(errorCount) AS avgErrors,
    COUNT(*) AS sampleCount
FROM PerformanceMetrics
WHERE difficultyLevel = ?
GROUP BY difficultyLevel;

-- NEW: Weak Areas and Coaching Context Queries

-- Insert or update weak area
insertOrReplaceWeakArea:
INSERT OR REPLACE INTO WeakArea(
    id, userId, skillArea, category, severityScore, frequencyCount,
    lastEncountered, averageAttempts, averageTimeSpent, commonErrors,
    improvementTrend, confidenceLevel, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get weak areas for user
selectWeakAreasByUser:
SELECT * FROM WeakArea
WHERE userId = ?
ORDER BY severityScore DESC, lastEncountered DESC;

-- Get specific weak area
selectWeakAreaBySkill:
SELECT * FROM WeakArea
WHERE userId = ? AND skillArea = ?;

-- Update weak area improvement trend
updateWeakAreaTrend:
UPDATE WeakArea
SET improvementTrend = ?, lastEncountered = ?, timestamp = ?
WHERE id = ?;

-- Insert or update coaching context
insertOrReplaceCoachingContext:
INSERT OR REPLACE INTO CoachingContext(
    userId, motivationalState, preferredCoachingStyle, contextSummary, lastUpdated
) VALUES (?, ?, ?, ?, ?);

-- Get coaching context for user
selectCoachingContext:
SELECT * FROM CoachingContext WHERE userId = ?;

-- Clean up old weak areas (older than 30 days)
deleteOldWeakAreas:
DELETE FROM WeakArea
WHERE timestamp < ? AND improvementTrend = 'IMPROVING';

-- NEW: Advanced Weak Area Prioritization Tables

-- Prioritized weak areas with intelligent ranking
CREATE TABLE PrioritizedWeakArea (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    weakAreaId TEXT NOT NULL,
    priorityLevel TEXT NOT NULL, -- CRITICAL, HIGH, MEDIUM, LOW
    priorityScore REAL NOT NULL,
    learningImpactLevel TEXT NOT NULL,
    learningImpactScore REAL NOT NULL,
    urgencyLevel TEXT NOT NULL,
    improvementDifficultyLevel TEXT NOT NULL,
    improvementDifficultyScore REAL NOT NULL,
    estimatedDays INTEGER NOT NULL,
    estimatedHours INTEGER NOT NULL,
    priorityReason TEXT NOT NULL,
    lastUpdated INTEGER NOT NULL,
    FOREIGN KEY (weakAreaId) REFERENCES WeakArea(id)
);

-- Improvement milestones and progress tracking
CREATE TABLE ImprovementMilestone (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    skillArea TEXT NOT NULL,
    currentSuccessRate REAL NOT NULL,
    targetSuccessRate REAL NOT NULL,
    targetDate INTEGER NOT NULL,
    description TEXT NOT NULL,
    isAchieved INTEGER NOT NULL, -- 0 = false, 1 = true
    achievedDate INTEGER,
    timestamp INTEGER NOT NULL
);

-- Recommended actions for improvement
CREATE TABLE RecommendedAction (
    id TEXT PRIMARY KEY,
    prioritizedWeakAreaId TEXT NOT NULL,
    actionType TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    estimatedTime INTEGER NOT NULL,
    priority INTEGER NOT NULL,
    isCompleted INTEGER NOT NULL DEFAULT 0,
    completedDate INTEGER,
    FOREIGN KEY (prioritizedWeakAreaId) REFERENCES PrioritizedWeakArea(id)
);

-- Skill-based challenge recommendations
CREATE TABLE SkillBasedRecommendation (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    skillArea TEXT NOT NULL,
    category TEXT NOT NULL,
    recommendedDifficulty TEXT NOT NULL,
    priority TEXT NOT NULL,
    reason TEXT NOT NULL,
    estimatedImpactScore REAL NOT NULL,
    challengeCount INTEGER NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 1,
    timestamp INTEGER NOT NULL
);

-- Real-time weak area insights
CREATE TABLE WeakAreaInsight (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    skillArea TEXT NOT NULL,
    insightType TEXT NOT NULL,
    message TEXT NOT NULL,
    severity TEXT NOT NULL,
    actionable INTEGER NOT NULL,
    suggestedAction TEXT,
    triggerEvent TEXT NOT NULL,
    isRead INTEGER NOT NULL DEFAULT 0,
    timestamp INTEGER NOT NULL
);

-- Skill mastery level tracking
CREATE TABLE SkillMasteryLevel (
    id TEXT PRIMARY KEY,
    userId TEXT NOT NULL,
    skillArea TEXT NOT NULL,
    category TEXT NOT NULL,
    currentLevel TEXT NOT NULL,
    progressToNext REAL NOT NULL,
    totalAttempted INTEGER NOT NULL,
    totalCompleted INTEGER NOT NULL,
    averagePerformance REAL NOT NULL,
    consistencyScore REAL NOT NULL,
    speedScore REAL NOT NULL,
    accuracyScore REAL NOT NULL,
    complexityHandling REAL NOT NULL,
    conceptualUnderstanding REAL NOT NULL,
    lastAssessment INTEGER NOT NULL,
    UNIQUE(userId, skillArea)
);

-- NEW: Advanced Weak Area Prioritization Queries

-- Insert prioritized weak area
insertPrioritizedWeakArea:
INSERT OR REPLACE INTO PrioritizedWeakArea(
    id, userId, weakAreaId, priorityLevel, priorityScore, learningImpactLevel,
    learningImpactScore, urgencyLevel, improvementDifficultyLevel,
    improvementDifficultyScore, estimatedDays, estimatedHours,
    priorityReason, lastUpdated
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get prioritized weak areas for user
selectPrioritizedWeakAreas:
SELECT * FROM PrioritizedWeakArea
WHERE userId = ?
ORDER BY priorityScore DESC, urgencyLevel DESC;

-- Insert improvement milestone
insertImprovementMilestone:
INSERT INTO ImprovementMilestone(
    id, userId, skillArea, currentSuccessRate, targetSuccessRate,
    targetDate, description, isAchieved, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get active milestones for user
selectActiveMilestones:
SELECT * FROM ImprovementMilestone
WHERE userId = ? AND isAchieved = 0
ORDER BY targetDate ASC;

-- Mark milestone as achieved
updateMilestoneAchieved:
UPDATE ImprovementMilestone
SET isAchieved = 1, achievedDate = ?
WHERE id = ?;

-- Insert recommended action
insertRecommendedAction:
INSERT INTO RecommendedAction(
    id, prioritizedWeakAreaId, actionType, title, description,
    estimatedTime, priority, isCompleted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Get recommended actions for prioritized weak area
selectRecommendedActions:
SELECT * FROM RecommendedAction
WHERE prioritizedWeakAreaId = ?
ORDER BY priority ASC;

-- Mark action as completed
updateActionCompleted:
UPDATE RecommendedAction
SET isCompleted = 1, completedDate = ?
WHERE id = ?;

-- Insert skill-based recommendation
insertSkillBasedRecommendation:
INSERT INTO SkillBasedRecommendation(
    id, userId, skillArea, category, recommendedDifficulty, priority,
    reason, estimatedImpactScore, challengeCount, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get active skill recommendations
selectActiveSkillRecommendations:
SELECT * FROM SkillBasedRecommendation
WHERE userId = ? AND isActive = 1
ORDER BY priority DESC, estimatedImpactScore DESC;

-- Insert weak area insight
insertWeakAreaInsight:
INSERT INTO WeakAreaInsight(
    id, userId, skillArea, insightType, message, severity,
    actionable, suggestedAction, triggerEvent, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get unread insights for user
selectUnreadInsights:
SELECT * FROM WeakAreaInsight
WHERE userId = ? AND isRead = 0
ORDER BY timestamp DESC;

-- Mark insight as read
updateInsightRead:
UPDATE WeakAreaInsight
SET isRead = 1
WHERE id = ?;

-- Insert or update skill mastery level
insertOrReplaceSkillMastery:
INSERT OR REPLACE INTO SkillMasteryLevel(
    id, userId, skillArea, category, currentLevel, progressToNext,
    totalAttempted, totalCompleted, averagePerformance, consistencyScore,
    speedScore, accuracyScore, complexityHandling, conceptualUnderstanding,
    lastAssessment
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get skill mastery levels for user
selectSkillMasteryLevels:
SELECT * FROM SkillMasteryLevel
WHERE userId = ?
ORDER BY currentLevel DESC, progressToNext DESC;
