) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


selectTaskById:
SELECT * FROM ChallengeTask WHERE id = ?;

insertChecklistProgress:
INSERT OR REPLACE INTO ChecklistProgress(id, taskId, item, isChecked)
VALUES (?, ?, ?, ?);

selectChecklistForTask:
SELECT * FROM ChecklistProgress WHERE taskId = ?;

